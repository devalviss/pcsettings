{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema_out.json",
    "logo": {
        "source": "/CAMINHO/DA/SUA/IMAGEM",
        "type": "kitty",
        "width": 28,
        "height": 20,
        "padding": {
            "top": 4,
            "right": 5
        }
    },
    "display": {
        "separator": "  →  ",
        "color": "yellow", // Cor das setas (Gruvbox Gold)
        "constants": [
            "────────────────────────────────────────────────"
        ]
    },
    "modules": [
        "title",
        {
            "type": "custom",
            "format": "┌{$1} Hardware Information {$1}┐",
            "outputColor": "33"
        },
        { "type": "host", "key": "  󰌢 ", "keyColor": "green" },
        { "type": "cpu", "key": "  󰻠 ", "keyColor": "green" },
        { "type": "gpu", "key": "  󰍛 ", "keyColor": "green" },
        { "type": "memory", "key": "  󰑭 ", "keyColor": "green" },
        { "type": "disk", "key": "  󰋊 ", "keyColor": "green" },
        //{ "type": "battery", "key": "  󰁹 ", "keyColor": "green" },
        //{ "type": "display", "key": "  󰍹 ", "keyColor": "green" },
        //{ "type": "brightness", "key": "  󰃠 ", "keyColor": "green" },
        //{ "type": "sound", "key": "  󰓃 ", "keyColor": "green" },
        
        {
            "type": "custom",
            "format": "├{$1} Software Information {$1}┤",
            "outputColor": "33"
        },
        { "type": "os", "key": "  󰣇 ", "keyColor": "cyan" },
        { "type": "kernel", "key": "  󰒓 ", "keyColor": "cyan" },
        { "type": "uptime", "key": "  󰔚 ", "keyColor": "cyan" },
        { "type": "packages", "key": "  󰏖 ", "keyColor": "cyan" },
        { "type": "shell", "key": "  󱆃 ", "keyColor": "cyan" },
        { "type": "terminal", "key": "  󰆍 ", "keyColor": "cyan" },
        { "type": "terminalfont", "key": "  󰛖 ", "keyColor": "cyan" },
        { "type": "wm", "key": "  󱂬 ", "keyColor": "cyan" },
        { "type": "de", "key": "  󰖲 ", "keyColor": "cyan" },
        { "type": "cursor", "key": "  󰇀 ", "keyColor": "cyan" },
        
        {
            "type": "custom",
            "format": "├{$1} Network & Security --{$1}┤",
            "outputColor": "33"
        },
        //{ "type": "localip", "key": "  󰩟 ", "keyColor": "yellow" },
        //{ "type": "publicip", "key": "  󰩠 ", "keyColor": "yellow" },
        { "type": "wifi", "key": "  󰖩 ", "keyColor": "yellow" },
        { "type": "users", "key": "  󰭹 ", "keyColor": "yellow" },
        { "type": "vulkan", "key": "  󰟵 ", "keyColor": "yellow" },
        { "type": "opengl", "key": "  󰟶 ", "keyColor": "yellow" },

        {
            "type": "custom",
            "format": "└{$1}──────────────────────{$1}┘",
            "outputColor": "33"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
